{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ERGOMS SECURE CONNECTION: setup",
      "detail": "Poetry + .venv + библиотеки (gui) и скачать sing-box в tools/",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/.vscode/setup.sh", "setup"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/.vscode/setup.ps1",
          "-Target",
          "setup"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "ERGOMS SECURE CONNECTION: build",
      "detail": "Собрать one-dir + установщик: dist/ErgomsSecureConnection/ и Setup.exe",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/.vscode/setup.sh", "build"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/.vscode/setup.ps1",
          "-Target",
          "build"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "showReuseMessage": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
