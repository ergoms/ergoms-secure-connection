# Client mode: socks | vps | singbox
#
# socks   = SSH SOCKS via your VPS (sshd on :443 through Squid)
# vps     = HTTPS git relay on your VPS (worker_base_url) or SOCKS if empty
# singbox = VLESS+Reality via Squid CONNECT (sing-box on VPS :443; see README)
MODE=socks

# SOCKS traffic scope (MODE=socks):
#   full    = all HTTP/S via VPS except config.json proxy_bypass
#   github  = only GitHub-related hosts (PAC), rest → corporate Squid
SOCKS_SCOPE=full

# TUN over SOCKS (sing-box virtual adapter → local SOCKS):
#   0 = off (manual TUN вкл in GUI still works and sets TUN=1)
#   1 = auto-start TUN after successful tunnel on (needs admin/UAC)
TUN=0

# Request UAC elevation when starting sing-box TUN (1/0)
TUN_ELEVATE=1

# TUN interface MTU (1400 = меньше фрагментации через SSH; диапазон 1280–1500)
# TUN_MTU=1400

# Watchdog: reconnect SOCKS / restart TUN when TUN=1 but sing-box died
# WATCHDOG=1
# WATCHDOG_INTERVAL=15
# WATCHDOG_MAX_RETRIES=5

# Local HTTP→SOCKS bridge port (git GCM / browsers / HTTP_PROXY)
# In MODE=singbox this is the sing-box HTTP inbound (not the Python bridge).
# HTTP_BRIDGE_PORT=1088

# PAC-only listener for MODE=singbox (AutoConfigURL); PAC points at HTTP_BRIDGE_PORT
# PAC_LISTEN_PORT=1089

# Shared secret for MODE=vps github_proxy (same value on the VPS).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# OPS_CONTENT_SECRET=

# Optional override of config.json corporate_proxy
# CORPORATE_PROXY=10.16.0.8:3128
