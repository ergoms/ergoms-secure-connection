# VLESS+Reality client (sing-box)

# Traffic scope for PAC / git:
#   full    = all HTTP/S via VPS except config.json proxy_bypass
#   github  = only GitHub-related hosts (PAC), rest → corporate Squid
SOCKS_SCOPE=full

# TUN in the same sing-box process (1 = auto after on)
TUN=0
TUN_ELEVATE=1

# Local ports
# HTTP_BRIDGE_PORT=1088
# PAC_LISTEN_PORT=1089

# Optional override of config.json corporate_proxy
# CORPORATE_PROXY=10.16.0.8:3128
