# Client mode: socks | vps
#
# socks = SSH SOCKS via your VPS (sshd on :443 through Squid)
# vps   = HTTPS git relay on your VPS (worker_base_url) or SOCKS if empty
MODE=socks

# SOCKS traffic scope (MODE=socks):
#   full    = all HTTP/S via VPS except config.json proxy_bypass
#   github  = only GitHub-related hosts (PAC), rest → corporate Squid
SOCKS_SCOPE=full

# Local HTTP→SOCKS bridge port (git GCM / browsers / HTTP_PROXY)
# HTTP_BRIDGE_PORT=1088

# Shared secret for MODE=vps github_proxy (same value on the VPS).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# OPS_CONTENT_SECRET=

# Optional
# CORPORATE_PROXY=10.16.0.8:3128
