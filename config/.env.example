# Client mode: socks | singbox
#
# socks   = sshd on VPS :443 + client: python -m desktop on / ops-content.ps1|.sh on
# singbox = sing-box VLESS+Reality on VPS :443 + same CLI client
MODE=socks

# SOCKS traffic scope:
#   full    = all HTTP/S via VPS except config.json proxy_bypass
#   github  = only GitHub-related hosts (PAC), rest → corporate Squid
SOCKS_SCOPE=full

# TUN (sing-box). socks: over SSH SOCKS; singbox: in the same process
# TUN=0
# TUN_ELEVATE=1

# Local HTTP→SOCKS bridge port
# HTTP_BRIDGE_PORT=1088

# Optional override of config.json corporate_proxy
# CORPORATE_PROXY=192.0.2.10:3128
