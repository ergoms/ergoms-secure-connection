[Unit]
Description=ops-content VLESS+Reality VPN
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/REPLACE/ops-content
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/REPLACE/ops-content
Environment=OPS_CONTENT_DATA=/REPLACE/ops-content
Environment=HOME=/REPLACE/home
Environment=USER=REPLACE_USER
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/REPLACE/python -m desktop watch
ExecStop=/REPLACE/python -m desktop off
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStartSec=90
TimeoutStopSec=20
Nice=-5

[Install]
WantedBy=multi-user.target
