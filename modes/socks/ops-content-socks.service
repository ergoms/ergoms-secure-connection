[Unit]
Description=ops-content SOCKS tunnel (SSH via corporate proxy -> VPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# WorkingDirectory and EnvironmentFile are rewritten by: ./ops-content.sh install-service
WorkingDirectory=/REPLACE/ops-content
EnvironmentFile=-/REPLACE/ops-content/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/REPLACE/ops-content/modes/socks/run-tunnel.sh
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=10

# Mild hardening (user unit; must still reach network + write creds/var)
NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Slightly nicer latency for the tunnel process
Nice=-5

[Install]
WantedBy=default.target
